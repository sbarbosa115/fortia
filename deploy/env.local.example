# backend/.env.local on the cPanel account: overrides backend/.env (the committed dev defaults). Never committed.
#   cp deploy/env.local.example backend/.env.local && chmod 600 backend/.env.local
# Each secret: a long random value, made with
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# deploy/cpanel-update.sh refuses to run while any of the "required" lines is missing or still a dev-only value.

APP_ENV=prod

# ── Required ──────────────────────────────────────────────────────────────────────────────────────────────────────
APP_SECRET=
# Signs the console's sign-in tokens. The keys in backend/config/jwt/ are made with it on the first deploy: changing
# it later means deleting config/jwt/*.pem (everyone signs in again).
JWT_PASSPHRASE=
# Respondent tokens of the assignations (PRD §13.1) and the storage's signed URLs (PRD §13.5).
RESPONDENT_TOKEN_SECRET=
STORAGE_SIGNING_SECRET=
# Seals the secrets accounts save (SMTP passwords, OpenAI and analytics keys). Never change it once set.
SETTINGS_ENCRYPTION_KEY=

# cPanel › MySQL Databases. URL-encode the password (@ → %40, # → %23…). serverVersion must describe the real server:
# the deploy prints it (MySQL: serverVersion=8.0.39; MariaDB: serverVersion=11.4.5-MariaDB).
DATABASE_URL="mysql://CPUSER_mappi:PASSWORD@localhost:3306/CPUSER_mappi?serverVersion=8.0.39&charset=utf8mb4"

# A mailbox of the domain (cPanel › Email Accounts): port 465 = smtps, 587 = smtp (STARTTLS).
MAILER_DSN="smtps://no-reply%40mappi.example.com:PASSWORD@mail.mappi.example.com:465"
SUPPORT_EMAIL=support@mappi.example.com

# One domain serves the API, the respondent app and the console (/console).
DEFAULT_URI=https://mappi.example.com
APP_URL=https://mappi.example.com
FRONTEND_URL=https://mappi.example.com
ADMIN_FRONTEND_URL=https://mappi.example.com/console
CORS_ALLOW_ORIGIN='^https://mappi\.example\.com$'

# ── Optional ──────────────────────────────────────────────────────────────────────────────────────────────────────
# Where "/" sends a visitor; empty = the marketing site. /console opens the console instead.
HOME_REDIRECT_URL=
MARKETING_SITE_URL=https://getmappi.com

# Answer files, prompts and other objects. Outside the clone survives a re-clone; never inside backend/public.
# Default: backend/var/storage.
#STORAGE_DIR=/home/CPUSER/mappi-storage

# Providers (README "External providers"). With the fakes, the AI answers from a keyword script.
LLM_PROVIDER=auto
OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-terra
TRANSCRIPTION_PROVIDER=browser
SCRAPER_PROVIDER=http
BRAND_EXTRACTOR=http
COMMERCE_PROVIDER=fake
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_INSTALL_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_SHEETS_CLIENT_ID=

ANALYTICS_BASE_URL=
ANALYTICS_API_KEY=
GA_MEASUREMENT_ID=
META_PIXEL_ID=
CLARITY_ID=
TIKTOK_PIXEL_ID=
