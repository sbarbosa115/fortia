{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals", "@testing-library/jest-dom", "webpack-env"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["assets/shared/*"],
      "@console/*": ["assets/console/*"],
      "@respondent/*": ["assets/respondent/*"],
      "@api-types/*": ["assets/types/*"]
    }
  },
  "include": [
    "assets/**/*.ts",
    "assets/**/*.tsx",
    "vitest.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", "public", "vendor", "var"]
}
