# Committed defaults for every environment. Real environment variables (docker-compose.yml) and the uncommitted
# .env.local win over these. Never put a production secret here: production reads them from a secrets manager.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dev-only-change-me-0f3c1e
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

DEFAULT_URI=http://localhost:8080

# ── URLs (PRD Appendix C) ──────────────────────────────────────────────────────────────────────────────────────────
# The API, the respondent app (FRONTEND_URL) and the console (ADMIN_FRONTEND_URL) are one Symfony app: the console
# lives under /console. In production each can be its own host.
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
ADMIN_FRONTEND_URL=http://localhost:8080/console
MARKETING_SITE_URL=https://getmappi.com
SUPPORT_EMAIL=support@mappi.test

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://app:app@database:3306/app?serverVersion=8.4.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailpit:1025
###< symfony/mailer ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=dev-only-jwt-passphrase
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

# ── Secrets of our own (dev defaults) ─────────────────────────────────────────────────────────────────────────────
# Assignation respondent tokens (PRD §13.1; D6: they expire).
RESPONDENT_TOKEN_SECRET=dev-only-respondent-token-secret-0123456789
RESPONDENT_TOKEN_TTL_DAYS=30
# Outgoing webhook signatures (PRD §7.14).
WEBHOOK_SIGNING_SECRET=dev-only-webhook-signing-secret
# Signed upload/download URLs of the local object storage (PRD §13.5).
STORAGE_DIR=%kernel.project_dir%/var/storage
STORAGE_SIGNING_SECRET=dev-only-storage-signing-secret

# ── External providers (ports + adapters) ─────────────────────────────────────────────────────────────────────────
# Each capability has a real adapter, used when its keys are set, and a deterministic fake for dev and tests.
# LLM: fake | anthropic
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL_GENERATION=claude-opus-5-5
LLM_MODEL_FAST=claude-haiku-4-5
# Payment gateway: fake | stripe
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Google sign-in (identity provider federation) and Google Sheets export (browser OAuth client)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_SHEETS_CLIENT_ID=
# E-commerce platform: fake | shopify
COMMERCE_PROVIDER=fake
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_INSTALL_URL=
# Catalog scraper: http (reads schema.org Product data from the page) | fake
SCRAPER_PROVIDER=fake
# LinkedIn profile scraper: fake
LINKEDIN_PROVIDER=fake
# Real-time transcription: browser (Web Speech API, dev) | openai
TRANSCRIPTION_PROVIDER=browser
OPENAI_API_KEY=

# ── Client-specific behaviour as configuration (D8) ───────────────────────────────────────────────────────────────
SAMURAI8_CUSTOMER_IDS=mateo
SAMURAI8_QUESTIONNAIRE_IDS=
LIVINGOOD_CUSTOMER_IDS=livingood
LINKEDIN_OWNER_CUSTOMER_ID=XhEFtqTt
SALES_LEAD_RECIPIENTS=sales@mappi.test
# JSON: {"<customer_id>": "<diagnostic results title>"}
DIAGNOSTIC_TITLE_OVERRIDES={}

# ── Measurement (D14: configuration, not hard-coded) ──────────────────────────────────────────────────────────────
GA_MEASUREMENT_ID=
META_PIXEL_ID=
CLARITY_ID=
TIKTOK_PIXEL_ID=
