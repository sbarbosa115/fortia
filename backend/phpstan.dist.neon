# PHPStan (steps/05-static-analysis.md §5.2). Raise the level one step at a time once clean; never lower it.
# Findings are fixed, not baselined: a deliberate exception goes in ignoreErrors with its reason.
includes:
    # Warms the debug test container and points the Symfony extension at its XML dump.
    - tests/phpstan-container.php

parameters:
    level: 6
    paths:
        - src
        - tests
    excludePaths:
        - tests/bootstrap.php
        - tests/phpstan-container.php
    doctrine:
        objectManagerLoader: tests/object-manager.php
