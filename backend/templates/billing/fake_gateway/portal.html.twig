{% extends 'billing/fake_gateway/layout.html.twig' %}

{% block title %}Billing portal · Test payment gateway{% endblock %}

{% block body %}
    <section class="card" aria-labelledby="portal-title">
        <h1 id="portal-title">Billing portal</h1>
        <p class="muted">Your subscriptions in the test gateway. "Simulate renewal" renews a subscription now, as the provider would on its renewal date: a scheduled plan starts, a canceled subscription ends.</p>
        {% if portal.subscriptions is empty %}
            <p>No subscriptions.</p>
        {% else %}
            <table>
                <thead><tr><th scope="col">Subscription</th><th scope="col">Status</th><th scope="col"></th></tr></thead>
                <tbody>
                {% for subscription in portal.subscriptions %}
                    <tr>
                        <td>
                            {{ subscription.price_id }}<br>
                            <span class="muted">
                                {% if subscription.cancel_at_period_end %}Ends on{% else %}Renews on{% endif %} {{ subscription.current_period_end }}
                                {% if subscription.scheduled_price_id %}· then {{ subscription.scheduled_price_id }}{% endif %}
                            </span>
                        </td>
                        <td>{{ subscription.status }}</td>
                        <td>
                            {% if subscription.status != 'canceled' %}
                                <form method="post" action="/fake-gateway/portal/{{ portal.id|url_encode }}/renew/{{ subscription.id|url_encode }}">
                                    <button type="submit">Simulate renewal</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
        <div class="actions">
            <a href="{{ portal.return_url }}">Return to Mappi</a>
        </div>
    </section>
{% endblock %}
