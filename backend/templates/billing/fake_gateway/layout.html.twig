{# The fake payment gateway's pages (dev and tests only, PAYMENT_PROVIDER=fake). Not the product's UI: plain and
   self-contained, English only, and they never ask for real payment data. #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>{% block title %}Test payment gateway{% endblock %}</title>
    <style>
        :root { --bg: #f7f7fa; --card: #fff; --text: #1b1a23; --muted: #5e5c6b; --line: #e6e5ec; --accent: #8249df; --danger: #c4314b; }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.5 Inter, "Segoe UI", Arial, sans-serif; }
        main { max-width: 480px; margin: 48px auto; padding: 0 16px; }
        .notice { background: #fff6db; border: 1px solid #f1d88a; border-radius: 10px; padding: 10px 14px; font-size: 13px; margin-bottom: 16px; }
        .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 24px; }
        h1 { font-size: 20px; margin: 0 0 4px; }
        .muted { color: var(--muted); font-size: 14px; }
        .price { font-size: 32px; font-weight: 700; margin: 16px 0 4px; }
        dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; margin: 16px 0; font-size: 14px; }
        dt { color: var(--muted); }
        dd { margin: 0; font-weight: 600; }
        label { display: block; font-size: 14px; font-weight: 600; margin: 16px 0 6px; }
        input[type=text] { width: 100%; height: 40px; border: 1px solid var(--line); border-radius: 10px; padding: 0 12px; font: inherit; text-transform: uppercase; }
        .actions { display: flex; gap: 12px; margin-top: 20px; flex-wrap: wrap; }
        button { height: 40px; border-radius: 999px; padding: 0 20px; font: inherit; font-weight: 600; cursor: pointer; border: 1px solid var(--line); background: #fff; color: var(--text); }
        button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
        .error { color: var(--danger); font-size: 14px; margin-top: 12px; }
        table { width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 16px; }
        th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--line); vertical-align: top; }
        a { color: var(--accent); }
    </style>
</head>
<body>
<main>
    <p class="notice" role="note">Test payment gateway — this page simulates the payment provider. No real card is charged and no payment data is asked for.</p>
    {% block body %}{% endblock %}
</main>
</body>
</html>
