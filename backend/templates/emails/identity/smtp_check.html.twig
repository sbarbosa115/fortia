{# The test email of /profile › System's "Validate", sent through the server being checked. Texts: emails_identity. #}
{% extends 'emails/layout.html.twig' %}

{% block title %}{{ 'smtp_check.subject'|trans({}, 'emails_identity', locale) }}{% endblock %}

{% block content %}
    <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;">{{ 'smtp_check.title'|trans({}, 'emails_identity', locale) }}</h1>
    <p style="margin:0 0 12px;">{{ 'smtp_check.intro'|trans({host: host, port: port}, 'emails_identity', locale) }}</p>
    <p style="margin:0;color:#5e5c6b;font-size:13px;">{{ 'smtp_check.sender'|trans({email: from_email}, 'emails_identity', locale) }}</p>
{% endblock %}
