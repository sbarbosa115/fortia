{# Password recovery (PRD §7.21): the code and a link to {ADMIN_URL}/reset-password?code=…. Texts: emails_identity. #}
{% extends 'emails/layout.html.twig' %}

{% block title %}{{ 'recovery.subject'|trans({}, 'emails_identity', locale) }}{% endblock %}

{% block content %}
    <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;">{{ 'recovery.title'|trans({}, 'emails_identity', locale) }}</h1>
    <p style="margin:0 0 12px;">{{ 'recovery.intro'|trans({}, 'emails_identity', locale) }}</p>
    <p style="margin:0 0 20px;font-size:30px;font-weight:700;letter-spacing:6px;color:#1b1a23;">{{ code }}</p>
    <p style="margin:0 0 24px;">
        <a href="{{ reset_url }}" style="display:inline-block;padding:10px 22px;border-radius:999px;background:#8249df;color:#ffffff;text-decoration:none;font-weight:600;">{{ 'recovery.cta'|trans({}, 'emails_identity', locale) }}</a>
    </p>
    <p style="margin:0 0 8px;color:#5e5c6b;font-size:13px;">{{ 'recovery.expires'|trans({minutes: minutes}, 'emails_identity', locale) }}</p>
    <p style="margin:0;color:#5e5c6b;font-size:13px;">{{ 'recovery.ignore'|trans({}, 'emails_identity', locale) }}</p>
{% endblock %}
