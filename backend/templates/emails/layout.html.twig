{# The layout of every email (PRD §7.21): sent from SUPPORT_EMAIL, in the account's language (es or en). A context's
   template extends it: {% extends 'emails/layout.html.twig' %} and fills the "content" block; texts come from its
   translations/emails_<context>+intl-icu.{es,en}.yaml. #}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Mappi{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background:#f7f7fa;font-family:Inter,Segoe UI,Arial,sans-serif;color:#1b1a23;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f7f7fa;padding:32px 16px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #e6e5ec;border-radius:14px;">
                    <tr>
                        <td style="padding:28px 32px 8px;font-size:20px;font-weight:700;color:#8249df;">Mappi</td>
                    </tr>
                    <tr>
                        <td style="padding:8px 32px 28px;font-size:15px;line-height:1.6;">
                            {% block content %}{% endblock %}
                        </td>
                    </tr>
                </table>
                <p style="margin:16px 0 0;font-size:12px;color:#5e5c6b;">{{ support_email }}</p>
            </td>
        </tr>
    </table>
</body>
</html>
