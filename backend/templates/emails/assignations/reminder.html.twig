{# The daily (or manual) reminder to the respondents of a follow-up (PRD §7.13). #}
{% extends 'emails/layout.html.twig' %}
{% set domain = 'emails_assignations' %}

{% block title %}{{ 'reminder.title'|trans({}, domain, locale) }}{% endblock %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:20px;">{{ 'reminder.title'|trans({}, domain, locale) }}</h1>
    <p style="margin:0 0 12px;">{{ 'reminder.body'|trans({name: assignation.name, organization: assignation.organization_name}, domain, locale) }}</p>
    <p style="margin:0 0 20px;">{{ ('reminder.due.' ~ timing.kind)|trans({days: timing.days, date: due_date}, domain, locale) }}</p>
    <p style="margin:0 0 20px;">
        <a href="{{ link }}" style="display:inline-block;background:#8249df;color:#ffffff;text-decoration:none;font-weight:600;padding:10px 22px;border-radius:999px;">{{ 'reminder.button'|trans({}, domain, locale) }}</a>
    </p>
    <p style="margin:0 0 4px;font-size:13px;color:#5e5c6b;">{{ link }}</p>
    <p style="margin:12px 0 0;font-size:13px;color:#5e5c6b;">{{ 'reminder.ignore'|trans({}, domain, locale) }}</p>
{% endblock %}
