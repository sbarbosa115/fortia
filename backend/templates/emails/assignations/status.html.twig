{# The follow-up status for the account's root users, sent with each reminder (PRD §7.13). #}
{% extends 'emails/layout.html.twig' %}
{% set domain = 'emails_assignations' %}

{% block title %}{{ 'status.title'|trans({}, domain, locale) }}{% endblock %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:20px;">{{ 'status.title'|trans({}, domain, locale) }}</h1>
    <p style="margin:0 0 12px;">{{ 'status.body'|trans({name: assignation.name, organization: assignation.organization_name}, domain, locale) }}</p>
    <ul style="margin:0 0 20px;padding-left:20px;">
        <li>{{ 'status.progress'|trans({completed: progress.completed, total: progress.total, percent: progress.percent}, domain, locale) }}</li>
        <li>{{ ('status.due.' ~ timing.kind)|trans({days: timing.days, date: due_date}, domain, locale) }}</li>
        <li>{{ 'status.reminded'|trans({count: reminded}, domain, locale) }}</li>
    </ul>
    <p style="margin:0 0 4px;">
        <a href="{{ link }}" style="display:inline-block;background:#8249df;color:#ffffff;text-decoration:none;font-weight:600;padding:10px 22px;border-radius:999px;">{{ 'status.button'|trans({}, domain, locale) }}</a>
    </p>
{% endblock %}
